    "voices": [
        {
            "id": "char_4183_mortis_CN_001",
            "title": {
                "en": "Appointed as Assistant",
                "jp": "秘書任命",
                "kr": "어시스턴트 임명",
                "cn": "任命助理"
            },
            "text": {
                "en": "If there's nothing to do, I'll... be here.",
                "jp": "やることないなら……ここにいる。",
                "kr": "할 일 없으면…… 여기 있어.",
                "cn": "没什么事的话……我会在这里安静待着。"
            },
            "asset": "char_4183_mortis/CN_001"
        },
        {
            "id": "char_4183_mortis_CN_002",
            "title": {
                "en": "Talk 1",
                "jp": "会話1",
                "kr": "대화 1",
                "cn": "交谈1"
            },
            "text": {
                "en": "Since when was I in the Activity Room...? Since... before you came in...",
                "jp": "いつから、活動室にいたか……？ドクターが来る前から、ずっと……",
                "kr": "언제부터, 활동실에 있었냐고……? 박사 오기 전부터, 계속……",
                "cn": "我是什么时候出现的？在你进入活动室之前，我就在了......"
            },
            "asset": "char_4183_mortis/CN_002"
        },
        {
            "id": "char_4183_mortis_CN_003",
            "title": {
                "en": "Talk 2",
                "jp": "会話2",
                "kr": "대화 2",
                "cn": "交谈2"
            },
            "text": {
                "en": "Vegetables... could grow well here.",
                "jp": "ここ、野菜……育てやすそう。",
                "kr": "여기, 야채…… 키우기 좋을 것 같아.",
                "cn": "这里……很适合种蔬菜。"
            },
            "asset": "char_4183_mortis/CN_003"
        },
        {
            "id": "char_4183_mortis_CN_004",
            "title": {
                "en": "Talk 3",
                "jp": "会話3",
                "kr": "대화 3",
                "cn": "交谈3"
            },
            "text": {
                "en": "You want me to play the guitar? Okay.",
                "jp": "ギター弾いてほしいの？わかった。",
                "kr": "기타 쳐줬으면 해? 알았어.",
                "cn": "希望我弹吉他吗？知道了。"
            },
            "asset": "char_4183_mortis/CN_004"
        },
        {
            "id": "char_4183_mortis_CN_005",
            "title": {
                "en": "Talk after Promotion 1",
                "jp": "昇進後会話1",
                "kr": "1차 정예화 후 대화",
                "cn": "晋升后交谈1"
            },
            "text": {
                "en": "I got this fragrance from Perfumer-san. She says Gloria uses it too.",
                "jp": "このアロマ、パフューマーさんから貰った。グロリアも使ってるって。",
                "kr": "이 아로마, 퍼퓨머 씨한테 받았어. 글로리아도 쓰고 있다더라고.",
                "cn": "这是调香师小姐给我的香水。葛罗莉亚也在用的。"
            },
            "asset": "char_4183_mortis/CN_005"
        },
        {
            "id": "char_4183_mortis_CN_006",
            "title": {
                "en": "Talk after Promotion 2",
                "jp": "昇進後会話2",
                "kr": "2차 정예화 후 대화",
                "cn": "晋升后交谈2"
            },
            "text": {
                "en": "Heheh... It's nice to... meet expectations.",
                "jp": "ふふ……期待に応えるの、いい感じ。",
                "kr": "후후…… 기대를 만족시키는 거, 좋은 느낌.",
                "cn": "嘿嘿……回应了大家的期待的感觉，还不坏。"
            },
            "asset": "char_4183_mortis/CN_006"
        },
        {
            "id": "char_4183_mortis_CN_007",
            "title": {
                "en": "Talk after Trust Increase 1",
                "jp": "信頼上昇後会話1",
                "kr": "신뢰도 상승 후 대화 1",
                "cn": "信赖提升后交谈1"
            },
            "text": {
                "en": "So you... also waver, and can't make up your mind... I... do that a lot...",
                "jp": "ドクターも、躊躇って決められないこと、あるんだ……私も、たくさんある……",
                "kr": "박사도 망설이면서 결정 못 하는 거, 있구나…… 나도, 많이 있어……",
                "cn": "即使是博士你，也会有犹豫不决的时候吗？我也经常这样......"
            },
            "asset": "char_4183_mortis/CN_007"
        },
        {
            "id": "char_4183_mortis_CN_008",
            "title": {
                "en": "Talk after Trust Increase 2",
                "jp": "信頼上昇後会話2",
                "kr": "신뢰도 상승 후 대화 2",
                "cn": "信赖提升后交谈2"
            },
            "text": {
                "en": "Saki once said... we're all 'badgers in the same hole'.",
                "jp": "祥が言ってた……私たちは「同じ穴のムジナ」だって。",
                "kr": "사키가 그랬어…… 우리는 '공범자'라고.",
                "cn": "祥说过，我们都是“一丘之貉”……"
            },
            "asset": "char_4183_mortis/CN_008"
        },
        {
            "id": "char_4183_mortis_CN_009",
            "title": {
                "en": "Talk after Trust Increase 3",
                "jp": "信頼上昇後会話3",
                "kr": "신뢰도 상승 후 대화 3",
                "cn": "信赖提升后交谈3"
            },
            "text": {
                "en": "Here, nobody recognizes... Minami-chan and Ta-kun...",
                "jp": "ここでは誰も、みなみちゃんやたぁくんを知らない……",
                "kr": "여기는 아무도, 미나미짱이나 타 군을 몰라……",
                "cn": "这里，谁都不认识森南和阿隆……"
            },
            "asset": "char_4183_mortis/CN_009"
        },
        {
            "id": "char_4183_mortis_CN_010",
            "title": {
                "en": "Idle",
                "jp": "放置",
                "kr": "방치",
                "cn": "闲置"
            },
            "text": {
                "en": "Did I wake you up? Sorry.",
                "jp": "起こした？ごめん。",
                "kr": "깨웠어? 미안.",
                "cn": "你起来了？抱歉。"
            },
            "asset": "char_4183_mortis/CN_010"
        },
        {
